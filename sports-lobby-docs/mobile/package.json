{
  "name": "sports-lobby-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run android:local",
    "android:local": "ENVFILE=.env.local react-native run-android --mode debug",
    "android:prod": "ENVFILE=.env.production react-native run-android --mode release",
    "ios": "npm run ios:local",
    "ios:local": "ENVFILE=.env.local react-native run-ios --mode Debug",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --mode Release",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "npm run start:local",
    "start:local": "ENVFILE=.env.local react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-config": "^1.6.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-maps": "^1.27.2",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5"
