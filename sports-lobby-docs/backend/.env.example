SPORTS_LOBBY_DB_URL=jdbc:postgresql://localhost:5432/sports_lobby
SPORTS_LOBBY_PRODUCTION_MODE=false
SPORTS_LOBBY_DB_USER=sports_lobby
SPORTS_LOBBY_DB_PASSWORD=sports_lobby_dev
SPORTS_LOBBY_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes-outside-dev
SPORTS_LOBBY_ACCESS_TOKEN_TTL=15m
SPORTS_LOBBY_REFRESH_TOKEN_TTL=30d
SPORTS_LOBBY_OTP_TTL=5m
SPORTS_LOBBY_OTP_RESEND_COOLDOWN=60s
SPORTS_LOBBY_OTP_MAX_ATTEMPTS=5
# Never enable outside automated/local test environments.
SPORTS_LOBBY_TEST_OTP_ENABLED=false
SPORTS_LOBBY_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
# Recommended for production instead of the primary account Auth Token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Legacy alternative to the API key pair above.
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SPORTS_LOBBY_REQUIRE_HTTPS=false
SPORTS_LOBBY_FORWARD_HEADERS_STRATEGY=none
SPORTS_LOBBY_RATE_LIMIT_ENABLED=true
SPORTS_LOBBY_RATE_LIMIT_MAX_KEYS=100000
SPORTS_LOBBY_PASSWORD_RESET_TTL=15m
SPORTS_LOBBY_FILES_PROVIDER=local
SPORTS_LOBBY_FILES_BUCKET=sports-lobby-dev
SPORTS_LOBBY_VENDOR_VERIFICATION_PREFIX=vendor-verification
SPORTS_LOBBY_SIGNED_UPLOAD_TTL=10m
SPORTS_LOBBY_SIGNED_DOWNLOAD_TTL=5m
SPORTS_LOBBY_VENDOR_DOC_MAX_BYTES=5242880
SPORTS_LOBBY_LOCAL_FILE_BASE_URL=http://localhost:8080
SPORTS_LOBBY_LOCAL_FILE_STORAGE_PATH=.local-object-storage
# For production use provider=s3 and supply AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# through the deployment secret manager or workload identity. Do not commit them.
AWS_REGION=me-south-1
SPORTS_LOBBY_S3_ENDPOINT=
SPORTS_LOBBY_S3_PATH_STYLE=false
# Google OAuth web client ID used to validate mobile ID tokens.
SPORTS_LOBBY_GOOGLE_AUTH_ENABLED=false
SPORTS_LOBBY_GOOGLE_WEB_CLIENT_ID=
